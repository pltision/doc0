---
import Layout from '@/layouts/Html.astro';
import fs from 'node:fs';
import path from 'node:path';

// 1. 获取 src/pages 的绝对路径
const pagesDir = path.join(process.cwd(), 'src', 'pages');

// 2. 递归获取所有 .astro 文件的相对路径（相对于 src/pages）
function getAllAstroFiles(dir, baseDir = dir) {
  const entries = fs.readdirSync(dir, { withFileTypes: true });
  let files = [];
  for (const entry of entries) {
    const fullPath = path.join(dir, entry.name);
    if (entry.isDirectory()) {
      files = files.concat(getAllAstroFiles(fullPath, baseDir));
    } else if (entry.isFile() && entry.name.endsWith('.astro')) {
      // 获取相对于 baseDir 的路径，并转为 POSIX 风格（/）
      const relative = path.relative(baseDir, fullPath);
      const posix = relative.split(path.sep).join('/');
      files.push(posix);
    }
  }
  return files;
}

const filePaths = getAllAstroFiles(pagesDir);

// 3. 生成路由
const pages = filePaths
  .map(filePath => {
    let route = filePath.replace(/\.astro$/, '');
    if (route === 'index') route = '';
    return '/' + route;
  })
  // .filter(route => route !== '/special/all-pages')
  .map(url => ({ url }));
---

<Layout>
  <h1>所有页面</h1>
  <p>在这里，你可以找到网站里面的所有页面。好耶！</p>
  <p>这是自动生成的。</p>
  <p>不包含图片等资源文件。</p>
  <p>模板？我不确定能不能支持，反正我还没用上。</p>

  {pages.length === 0 ? (
    <p>看起来，没能从网站里找到任何页面...</p>
    <p>检查你的 <code>src/pages</code> 文件夹。</p>
  ) : (
    <ul>
      {pages.map(page => (
        <li>
          <a href={page.url}>{page.url}</a>
        </li>
      ))}
    </ul>
  )}
</Layout>