---
import HealthIcon from "./HealthIcon.astro";
import HealthIconHarf from "./HealthIconHarf.astro";
import "@/styles/inline_icon.css";

interface Props {
    p: string;
}
const { p } = Astro.props;

const healthNumber = Number(p);

const overflow = 10;

const displayFullHeart =
    // 是不是正数（如果是NaN那也为假）
    healthNumber > 0;

const printAllOfIcon =
    // 是否小于等于 overflow
    healthNumber <= overflow &&
    // 是不是整数（半心）
    Number.isInteger(healthNumber);

// 计算完整图标数量和是否有半图标
const fullCount = Math.floor(healthNumber / 2);
const hasHalf = healthNumber % 2 === 1;
---

<span title={p + " 点生命"}>
    <HealthIconHarf c="character-game-object-icon" />×{p}
</span>


{
    // 显示完整心的个数
    displayFullHeart
        ? 
          (
            <>&nbsp;(</>
            <span title={healthNumber / 2 + " 颗心"}>
                {printAllOfIcon ? (
                    // 直接打印 healthNumber 个心
                    <>
                        {Array.from({ length: fullCount }, () => (
                            <HealthIcon c="character-game-object-icon" />
                        ))}
                        {hasHalf && (
                            <HealthIconHarf c="character-game-object-icon" />
                        )}
                    </>
                ) : (
                    // 打印 healthNumber × 心
                    <>
                        <HealthIcon c="character-game-object-icon" />×
                        {healthNumber / 2}
                    </>
                )}
            </span>
            <>)</>
          )
        : ""
}
